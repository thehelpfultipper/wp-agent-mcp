WP_ROOT=/absolute/path/to/wordpress
MCP_PORT=7337
WP_CLI=wp # optional
PHP_BIN=php # optional
WP_AGENT_ALLOWED_DUMP_ROOTS= # optional, path-delimited absolute roots for dump imports
# Prepend directories to PATH for WP-CLI child processes (fixes "mysql: No such file" when Cursor MCP has a minimal PATH). Example macOS Homebrew mysql-client:
# WP_AGENT_EXTRA_PATH=/opt/homebrew/opt/mysql-client/bin
# Windows example (use ; for multiple):
# WP_AGENT_EXTRA_PATH=C:\\Program Files\\MySQL\\MySQL Server 8.0\\bin
WP_AGENT_EXTRA_PATH=
# Set to 0 to skip bulk UPDATE of `{prefix}site` / `{prefix}blogs` domain columns during multisite sync (subdomain installs).
# WP_AGENT_MS_ALIGN_DOMAIN_COLUMNS=0